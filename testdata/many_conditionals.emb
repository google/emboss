# Exercises disjunction-of-equality matching: each conditional field is
# guarded by an `||` of multiple discriminant values, which collapses into a
# single multi-label switch arm under the optimized Ok() generator.
struct DisjunctionConditionals:
  0 [+4]                                       UInt  tag
  if tag == 0 || tag == 1 || tag == 2:
    4 [+4]                                     UInt  shared_low
  if tag == 10 || tag == 11:
    4 [+4]                                     UInt  shared_high
  if tag == 100 || tag == 200 || tag == 300:
    4 [+4]                                     UInt  shared_far

# Exercises residual-read elimination (Lever A): a proper tag-discriminated
# switch where every arm additionally carries a shared residual guard
# (`outer == 1`). The discriminant `tag` is decoded once by the switch; the
# residual is the only per-arm predicate, so the optimized Ok() gates each
# field on the residual alone rather than re-deriving the full has_gN()
# existence condition (which would redundantly re-read and re-compare tag).
# The always-present `outer` field makes `tag` provably Known, so the switch
# survives demotion. Contrast LargeConditionals (all bare arms), the control.
struct OuterGuardedUnion:
  0 [+4]  UInt  outer
  4 [+4]  UInt  tag
  if tag == 0 && outer == 1:
    8 [+4]  UInt  g0

  if tag == 1 && outer == 1:
    8 [+4]  UInt  g1

  if tag == 2 && outer == 1:
    8 [+4]  UInt  g2

  if tag == 3 && outer == 1:
    8 [+4]  UInt  g3

  if tag == 4 && outer == 1:
    8 [+4]  UInt  g4

  if tag == 5 && outer == 1:
    8 [+4]  UInt  g5

